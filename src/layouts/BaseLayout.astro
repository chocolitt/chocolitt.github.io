---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { normalizeDescription } from "../utils/description";
import { canonicalPath as normalizeCanonicalPath } from "../utils/url";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string | false;
  type?: "website" | "article";
  math?: boolean;
  noindex?: boolean;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  type = "website",
  math = false,
  noindex = false,
  structuredData,
} = Astro.props;
const fullTitle = title === "Daniel Litt" ? title : `${title} · Daniel Litt`;
const metaDescription = normalizeDescription(description, title);
const canonical = canonicalPath === false ? undefined : new URL(normalizeCanonicalPath(canonicalPath), Astro.site);
const socialImage = new URL("/images/daniel-litt-social-diagram.png", Astro.site);
const socialImageAlt = "Mathematical diagram of X with curves, loops, and dotted paths from a base point.";
const isPreview = import.meta.env.PUBLIC_SITE_ENV === "preview";
const robots = isPreview ? "noindex,nofollow" : noindex ? "noindex,follow" : undefined;
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Daniel Litt",
  url: "https://www.daniellitt.com",
  jobTitle: "Mathematician",
  affiliation: {
    "@type": "CollegeOrUniversity",
    name: "University of Toronto",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#fcfcfc" />
    {robots && <meta name="robots" content={robots} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Daniel Litt" href={new URL("/rss.xml", Astro.site)} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="2432" />
    <meta property="og:image:height" content="1222" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <title>{fullTitle}</title>
    {canonicalPath === "/" && <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />}
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    {math && (
      <>
        <script is:inline>
          window.MathJax = {
            tex: {
              inlineMath: [["$", "$"], ["\\(", "\\)"]],
              displayMath: [["$$", "$$"], ["\\[", "\\]"]],
            },
            options: { skipHtmlTags: ["script", "noscript", "style", "textarea", "pre", "code"] },
          };
        </script>
        <script
          is:inline
          async
          src="https://cdn.jsdelivr.net/npm/mathjax@3.2.2/es5/tex-chtml.js"
          integrity="sha384-AHAnt9ZhGeHIrydA1Kp1L7FN+2UosbF7RQg6C+9Is/a7kDpQ1684C2iH2VWil6r4"
          crossorigin="anonymous"
        ></script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <SiteHeader />
    <div class="shell"><div class="page-divider"></div></div>
    <main id="content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
