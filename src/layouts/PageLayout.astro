---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  entry: CollectionEntry<"pages">;
}

const { entry } = Astro.props;
const { title, displayTitle, description, legacyPath, math } = entry.data;
const pageName = legacyPath.replace(/^\//, "").replace(/\//g, "-") || "home";
---

<BaseLayout title={title} description={description} canonicalPath={legacyPath} math={math}>
  <article class="standard-page shell page-content prose" data-page={pageName}>
    <h1>{displayTitle ?? title}</h1>
    <slot />
  </article>
</BaseLayout>

<style>
  .standard-page {
    max-width: var(--site-width);
  }

  .standard-page h1 {
    margin-top: 0;
  }
</style>
