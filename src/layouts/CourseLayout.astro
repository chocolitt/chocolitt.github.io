---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  entry: CollectionEntry<"courses">;
}

const { entry } = Astro.props;
const { title, code, institution, term, summary, archived, legacyPath } = entry.data;
---

<BaseLayout title={`${code}: ${title}`} description={summary} canonicalPath={legacyPath ?? Astro.url.pathname} math>
  <article class="course-shell shell page-content">
    <header class="course-header">
      <h1>{code}: {title}</h1>
      <p>{institution} · {term}{archived ? " · Course archive" : ""}</p>
      <p>{summary}</p>
      {legacyPath && <p><a href={legacyPath}>Original course-page address</a></p>}
    </header>
    <nav class="course-nav" aria-label="On this page">
      <slot name="navigation" />
    </nav>
    <div class="prose course-body">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .course-header h1 {
    margin-top: 0;
  }

  .course-header {
    border-bottom: 1px solid var(--line);
    padding-bottom: 1.25rem;
  }

  .course-nav {
    font-family: var(--display-font);
    font-size: 0.8rem;
    margin-block: 1.5rem 2rem;
  }

  .course-nav :global(ul) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .course-body {
    max-width: 900px;
  }
</style>
