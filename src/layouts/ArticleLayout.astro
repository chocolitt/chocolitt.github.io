---
import type { CollectionEntry } from "astro:content";
import FastComments from "../components/FastComments.astro";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const { title, description, published, updated, comments, legacyPath } = entry.data;
const dateFormatter = new Intl.DateTimeFormat("en-US", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout title={title} description={description} canonicalPath={legacyPath} type="article" math>
  <article class="article-shell shell page-content">
    <p class="collection-title"><a href="/blog">βlog</a></p>
    <header class="article-header">
      <h1>{title}</h1>
      <p class="article-meta">
        <time datetime={published.toISOString()}>{dateFormatter.format(published)}</time>
        {updated && <span> · Updated {dateFormatter.format(updated)}</span>}
      </p>
    </header>
    <div class="prose article-body">
      <slot />
    </div>
    {comments && <FastComments urlId={legacyPath} />}
  </article>
</BaseLayout>

<style>
  .article-shell {
    max-width: var(--site-width);
  }

  .collection-title {
    font-family: var(--display-font);
    font-size: 2rem;
    font-weight: 300;
    letter-spacing: 0.06em;
    line-height: 1.35;
    margin: 0 0 1.6em;
    text-transform: uppercase;
  }

  .collection-title a {
    color: var(--heading);
  }

  .article-header {
    margin-bottom: 2.3rem;
  }

  .article-header h1 {
    margin: 0 0 0.35rem;
  }

  .article-meta {
    color: #777;
    font-family: var(--display-font);
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    margin: 0;
  }

  .article-body :global(img) {
    display: block;
    margin-inline: auto;
  }

  .article-body :global(figure) {
    margin-block: 2rem;
  }

  .article-body :global(sup) {
    font-size: 0.7em;
  }
</style>
