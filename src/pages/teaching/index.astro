---
import { getEntry, render } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";

const entry = await getEntry("pages", "teaching");
if (!entry) throw new Error("Missing imported /teaching page content");
const { Content } = await render(entry);
---

<PageLayout entry={entry}>
  <Content />
  <section class="integrated-archives">
    <h2>Course Archives and Downloads</h2>
    <div class="teaching-page">
    <ul class="course-list">
      <li><a href="/mat445_winter2026.html">MAT445H1 – Representation Theory, Winter 2026</a> <span>Archived course</span></li>
      <li><a href="/mat445.html">Math 445 – Representation Theory, Winter 2025</a> <span>Archived course</span></li>
      <li><a href="/mat1190hs.html">MAT1190HS – Algebraic Geometry</a> <span>Archived course</span></li>
      <li><a href="/mat1101.html">Math 1101 – Algebra II, Winter 2025</a> <span>Archived course</span></li>
    </ul>

    <h2>Notes and Downloads</h2>
    <ul>
      <li><a href="/AG_notes_1.pdf">Algebraic geometry notes (PDF)</a> · <a href="/AG_notes_1.tex">TeX source</a></li>
      <li><a href="/grassmannian_frobenius_counterexample.pdf">Grassmannian Frobenius counterexample (PDF)</a></li>
      <li><a href="/jacob_mathilde_notes.pdf">Jacob and Mathilde’s notes (PDF)</a></li>
      <li><a href="/Hartshorne%20III.png">Hartshorne III image</a></li>
      <li>
        <a href="/MAT445H1_%20Representation%20Theory%202026.docx%20-%20Google%20Docs%20%282%29.pdf">
          MAT445H1 Representation Theory 2026 syllabus (PDF)
        </a>
      </li>
    </ul>
    </div>
  </section>
</PageLayout>

<style>
  .teaching-page {
    margin: 0;
    padding: 0;
  }

  .teaching-page :global(ul) {
    padding-left: 1.4rem;
  }

  .teaching-page :global(li) {
    margin-bottom: 0.4rem;
  }

  .course-list :global(span) {
    color: var(--muted);
    font-family: var(--display-font);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    margin-left: 0.4rem;
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>
