---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { normalizeDescription, normalizeSearchText } from "../utils/description";

const posts = await getCollection("blog", ({ data }) => !data.draft || import.meta.env.DEV);
const pages = await getCollection("pages");
const courses = await getCollection("courses");
const publications = await getEntry("publications", "page");
const publicationText = publications?.data.grids.flatMap((grid) => [
  grid.sidebar.heading,
  grid.sidebar.body,
  ...grid.groups.flatMap((group) => [
    group.heading,
    ...group.publications.flatMap((publication) => [
      publication.title,
      publication.citation,
      publication.abstract,
    ]),
  ]),
]).join(" ");
const results = [
  ...pages.filter((entry) => entry.data.legacyPath !== "/publications-and-preprints").map((entry) => ({
    title: entry.data.title,
    description: normalizeDescription(entry.data.description, entry.data.title),
    href: entry.data.legacyPath,
    searchText: normalizeSearchText(entry.data.title, entry.data.description, entry.body),
  })),
  ...posts.map((entry) => ({
    title: entry.data.title,
    description: normalizeDescription(entry.data.description, entry.data.title),
    href: entry.data.legacyPath,
    searchText: normalizeSearchText(entry.data.title, entry.data.description, entry.body),
  })),
  ...courses.map((entry) => ({
    title: entry.data.title,
    description: normalizeDescription(entry.data.summary, entry.data.title),
    href: entry.data.legacyPath,
    searchText: normalizeSearchText(entry.data.title, entry.data.summary, entry.body),
  })),
  {
    title: "Publications and Preprints",
    description: "Papers and preprints by Daniel Litt, with citations and abstracts.",
    href: "/publications-and-preprints",
    searchText: normalizeSearchText("Publications and Preprints", publicationText),
  },
  {
    title: "Real Fano Surface Visualization",
    description: "An interactive three-dimensional mesh visualization of the real Fano surface.",
    href: "/fermat_fano_real_mesh_web.html",
    searchText: normalizeSearchText("Real Fano Surface Visualization Fermat cubic threefold Grassmannian mesh divisor"),
  },
  {
    title: "Single-author Paper Reviews, Audits, and Errata",
    description: "Refine reviews, mathematical audits, and errata for eight single-author published papers.",
    href: "/published-paper-reviews.html",
    searchText: normalizeSearchText(
      "Single-author paper reviews audits errata Refine",
      "Motives mapping class groups monodromy Arithmetic representations fundamental groups finiteness Vanishing Frobenius twists ample vector bundles Non-abelian Lefschetz hyperplane theorems Manifolds containing ample projective bundle Zeta functions curves no rational points Symmetric powers do not stabilize",
    ),
  },
].sort((a, b) => a.title.localeCompare(b.title));
---

<BaseLayout title="Search" description="Search Daniel Litt's website." canonicalPath="/search" math>
  <section class="search-page shell page-content">
    <header class="section-intro">
      <h1>Search</h1>
    </header>
    <form class="search-form" action="/search" method="get" role="search">
      <label for="site-search">Search this site</label>
      <input id="site-search" name="q" type="search" autocomplete="off" />
    </form>
    <p id="search-status" aria-live="polite">Enter a word or phrase to search.</p>
    <ol id="search-results" class="plain-list" hidden>
      {results.map((result) => (
        <li data-search={result.searchText}>
          <h2><a href={result.href}>{result.title}</a></h2>
          <p>{result.description}</p>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>("#site-search");
  const status = document.querySelector<HTMLElement>("#search-status");
  const list = document.querySelector<HTMLOListElement>("#search-results");
  const items = [...document.querySelectorAll<HTMLElement>("#search-results > li")];
  const initialQuery = new URLSearchParams(window.location.search).get("q") || "";

  const normalizeQuery = (value: string) => value
    .replace(/[_{}$\\]/g, "")
    .normalize("NFKD")
    .toLocaleLowerCase()
    .replace(/[^\p{L}\p{N}]+/gu, " ")
    .replace(/\s+/g, " ")
    .trim();

  const update = () => {
    const query = normalizeQuery(input?.value || "");
    if (!list || !status) return;
    if (!query) {
      list.hidden = true;
      for (const item of items) item.hidden = false;
      status.textContent = "Enter a word or phrase to search.";
      return;
    }
    let count = 0;
    for (const item of items) {
      const matches = (item.dataset.search || "").includes(query);
      item.hidden = !matches;
      if (matches) count += 1;
    }
    list.hidden = false;
    status.textContent = `${count} ${count === 1 ? "result" : "results"}.`;
  };

  if (input) {
    input.value = initialQuery;
    input.addEventListener("input", update);
    update();
  }
</script>

<style>
  .search-page {
    max-width: var(--site-width);
  }

  .search-form {
    max-width: 42rem;
  }

  label {
    display: block;
    font-family: var(--display-font);
    font-size: 0.82rem;
    letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
    text-transform: uppercase;
  }

  input {
    background: white;
    border: 1px solid #8a8a8a;
    border-radius: 0;
    color: var(--text);
    font: inherit;
    padding: 0.65rem 0.75rem;
    width: 100%;
  }

  input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  li {
    border-top: 1px solid var(--line);
    padding-block: 1.4rem;
  }

  li h2 {
    font-size: 1.2rem;
    margin: 0 0 0.4rem;
  }

  li p {
    margin: 0;
  }
</style>
