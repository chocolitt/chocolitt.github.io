---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
const courses = await getCollection("courses");
const dateFormatter = new Intl.DateTimeFormat("en-CA", {
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout
  title="Daniel Litt"
  description="Daniel Litt is a mathematician working in algebraic geometry, arithmetic geometry, and related subjects."
>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">Mathematics · Writing · Teaching</p>
      <h1>Daniel Litt</h1>
      <p class="lede">
        I’m a mathematician at the University of Toronto. I work mainly in algebraic and arithmetic geometry,
        and write about mathematics, research, and the culture around them.
      </p>
      <div class="cluster hero-links">
        <a class="primary-link" href="/blog">Read the writing</a>
        <a href="mailto:daniel.litt@utoronto.ca">Get in touch</a>
      </div>
    </div>
    <aside class="research-note" aria-label="Research interests">
      <p class="eyebrow">Research interests</p>
      <p>Algebraic geometry</p>
      <p>Arithmetic geometry</p>
      <p>Fundamental groups</p>
      <p>Hodge theory</p>
    </aside>
  </section>

  <section class="home-section shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Recent</p>
        <h2>Writing</h2>
      </div>
      <a href="/blog">All writing →</a>
    </div>
    <ol class="feature-list plain-list">
      {posts.slice(0, 3).map((post) => (
        <li>
          <a href={post.data.legacyPath}>
            <time datetime={post.data.published.toISOString()}>{dateFormatter.format(post.data.published)}</time>
            <span><strong>{post.data.title}</strong><small>{post.data.description}</small></span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="home-section shell twin-grid">
    <div>
      <p class="eyebrow">Teaching</p>
      <h2>Courses and notes</h2>
      <p>Course pages, syllabi, lecture schedules, and mathematical notes.</p>
      <ul class="plain-list compact-links">
        {courses.map((course) => (
          <li><a href={`/teaching/${course.id}`}>{course.data.code}: {course.data.title}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="eyebrow">Projects</p>
      <h2>Interactive artifacts</h2>
      <p>Small computational and bibliographic projects that live alongside the writing.</p>
      <ul class="plain-list compact-links">
        <li><a href="/fermat_fano_real_mesh_web.html">Real Fano surface visualization</a></li>
        <li><a href="/published-paper-reviews.html">Published paper review archive</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    align-items: end;
    display: grid;
    gap: clamp(2.5rem, 8vw, 8rem);
    grid-template-columns: minmax(0, 1.8fr) minmax(14rem, 0.65fr);
    min-height: 36rem;
    padding-block: clamp(4rem, 11vw, 8rem);
  }

  .hero-copy h1 {
    font-size: clamp(4rem, 14vw, 9rem);
    letter-spacing: -0.065em;
    line-height: 0.9;
  }

  .hero-copy .lede {
    max-width: 39rem;
  }

  .hero-links {
    font-family: var(--sans);
    font-size: 0.8rem;
    margin-top: 2rem;
  }

  .primary-link {
    background: var(--ink);
    color: var(--paper);
    padding: 0.65rem 0.9rem;
    text-decoration: none;
  }

  .primary-link:hover {
    background: var(--accent-dark);
    color: white;
  }

  .research-note {
    border-top: 3px solid var(--accent);
    font-family: var(--sans);
    padding-top: 1rem;
  }

  .research-note p:not(.eyebrow) {
    border-bottom: 1px solid var(--line);
    font-size: 0.78rem;
    margin: 0;
    padding-block: 0.5rem;
  }

  .home-section {
    border-top: 1px solid var(--line);
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .section-heading {
    align-items: end;
    display: flex;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .section-heading h2,
  .twin-grid h2 {
    margin: 0;
  }

  .section-heading > a {
    font-family: var(--sans);
    font-size: 0.76rem;
  }

  .feature-list li {
    border-top: 1px solid var(--line);
  }

  .feature-list a {
    align-items: baseline;
    color: var(--ink);
    display: grid;
    gap: 1rem;
    grid-template-columns: 7rem 1fr auto;
    padding-block: 1.2rem;
    text-decoration: none;
  }

  .feature-list time,
  .feature-list small,
  .arrow {
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.72rem;
  }

  .feature-list strong,
  .feature-list small {
    display: block;
  }

  .feature-list strong {
    font-size: 1.15rem;
  }

  .feature-list small {
    margin-top: 0.25rem;
  }

  .twin-grid {
    display: grid;
    gap: clamp(3rem, 9vw, 8rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .twin-grid > div > p:not(.eyebrow) {
    color: var(--muted);
    max-width: 30rem;
  }

  .compact-links {
    font-family: var(--sans);
    font-size: 0.8rem;
    margin-top: 1.5rem;
  }

  .compact-links li {
    border-top: 1px solid var(--line);
    padding-block: 0.65rem;
  }

  @media (max-width: 760px) {
    .hero,
    .twin-grid {
      grid-template-columns: 1fr;
    }

    .hero {
      align-items: start;
      min-height: auto;
    }

    .feature-list a {
      grid-template-columns: 1fr auto;
    }

    .feature-list time {
      grid-column: 1 / -1;
    }
  }
</style>
