---
import { getCollection, render } from "astro:content";
import BlogFrame from "../../components/BlogFrame.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft || import.meta.env.DEV)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
const feedPosts = await Promise.all(
  posts.slice(0, 20).map(async (post) => ({ post, Content: (await render(post)).Content })),
);
const olderPosts = posts.slice(20);
const dateFormatter = new Intl.DateTimeFormat("en-US", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout
  title="Betalog"
  description="Blog of Daniel Litt, about math and other things."
  math={feedPosts.some(({ post }) => post.data.math)}
>
  <BlogFrame isIndex>
    <div class="blog-feed">
      {feedPosts.map(({ post, Content }) => (
        <article class="feed-item" data-post-path={post.data.legacyPath}>
          <header class="post-header">
            <h2>
              <a href={post.data.legacyPath}>{post.data.title}</a>
              {post.data.draft && <span class="draft-label">Draft</span>}
            </h2>
            <p class="post-meta">
              <time datetime={post.data.published.toISOString()}>{dateFormatter.format(post.data.published)}</time>
            </p>
          </header>
          {post.data.indexExcerpt ? (
            <div class="prose blog-post-body" set:html={post.data.indexExcerpt} />
          ) : (
            <div class="prose blog-post-body"><Content /></div>
          )}
          {post.data.indexExcerpt && (
            <p class="read-more"><a href={post.data.legacyPath}>Read More →</a></p>
          )}
        </article>
      ))}
    </div>

    {olderPosts.length > 0 && (
      <details class="older-posts">
        <summary>Older Posts →</summary>
        <ol>
          {olderPosts.map((post) => (
            <li>
              <a href={post.data.legacyPath}>{post.data.title}</a>
              <time datetime={post.data.published.toISOString()}>{dateFormatter.format(post.data.published)}</time>
            </li>
          ))}
        </ol>
      </details>
    )}
  </BlogFrame>
</BaseLayout>

<script>
  for (const article of document.querySelectorAll<HTMLElement>(".feed-item[data-post-path]")) {
    const postPath = article.dataset.postPath;
    if (!postPath) continue;
    for (const link of article.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')) {
      link.href = `${postPath}${link.getAttribute("href")}`;
    }
  }
</script>

<style>
  .feed-item + .feed-item {
    border-top: 1px solid var(--line);
    margin-top: 84px;
    padding-top: 95px;
  }

  .post-header {
    margin-bottom: 15px;
  }

  .post-header h2 {
    font-size: 2rem;
    line-height: 1.5;
    margin: 0 0 6px;
  }

  .post-header h2 a {
    color: var(--heading);
  }

  .post-meta {
    color: #b3b3b3;
    font-size: 0.9rem;
    line-height: 2;
    margin: 0;
  }

  .draft-label {
    border: 1px solid var(--line);
    color: var(--muted);
    display: inline-block;
    font-family: var(--body-font);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    margin-left: 0.7rem;
    padding: 0.15rem 0.4rem;
    text-transform: uppercase;
    vertical-align: middle;
  }

  .blog-post-body :global(> :first-child) {
    margin-top: 0;
  }

  .blog-post-body :global(img) {
    display: block;
    margin-inline: auto;
  }

  .blog-post-body :global(h2) {
    line-height: 1.2;
  }

  .read-more {
    font-family: var(--display-font);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    margin: 1.5rem 0 0;
    text-transform: uppercase;
  }

  .older-posts {
    border-top: 1px solid var(--line);
    margin-top: 90px;
    padding-top: 36px;
  }

  .older-posts summary {
    color: var(--heading);
    cursor: pointer;
    font-family: var(--display-font);
    letter-spacing: 0.06em;
    list-style: none;
    text-transform: uppercase;
  }

  .older-posts summary::-webkit-details-marker {
    display: none;
  }

  .older-posts ol {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .older-posts li + li {
    margin-top: 1rem;
  }

  .older-posts a {
    display: block;
    font-family: var(--display-font);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .older-posts time {
    color: var(--muted);
    display: block;
    font-size: 0.85rem;
  }
</style>
