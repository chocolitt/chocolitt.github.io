---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
const dateFormatter = new Intl.DateTimeFormat("en-US", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout title="Betalog" description="Blog of Daniel Litt, about math and other things.">
  <section class="blog-index shell page-content">
    <header class="section-intro">
      <h1>βlog</h1>
      <p>Blog of Daniel Litt, about math and other things.</p>
    </header>
    <ol class="post-list plain-list">
      {posts.map((post) => (
        <li>
          <article>
            <h2><a href={post.data.legacyPath}>{post.data.title}</a></h2>
            <time datetime={post.data.published.toISOString()}>{dateFormatter.format(post.data.published)}</time>
            <p>{post.data.description}</p>
            <a class="read-more" href={post.data.legacyPath}>Read more</a>
          </article>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .blog-index {
    max-width: var(--site-width);
  }

  .section-intro p {
    margin: 0;
  }

  .post-list li + li {
    border-top: 1px solid var(--line);
    margin-top: 2.5rem;
    padding-top: 2.5rem;
  }

  article h2 {
    font-size: 2rem;
    margin: 0 0 0.2rem;
  }

  article h2 a {
    color: var(--heading);
  }

  time,
  .read-more {
    color: var(--muted);
    font-family: var(--display-font);
    font-size: 0.78rem;
    letter-spacing: 0.03em;
  }

  article p {
    margin-top: 1.25rem;
    max-width: 58rem;
  }

  .read-more {
    color: var(--link);
  }
</style>
