---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
const dateFormatter = new Intl.DateTimeFormat("en-CA", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout title="Writing" description="Essays and notes by Daniel Litt on mathematics, research, and adjacent subjects.">
  <section class="page-intro shell reading-width">
    <p class="eyebrow">Archive</p>
    <h1>Writing</h1>
    <p class="lede">Essays and notes on mathematics, research, technology, and the culture around them.</p>
  </section>
  <section class="shell post-list" aria-label="Posts">
    <ol class="plain-list">
      {posts.map((post) => (
        <li>
          <article>
            <time datetime={post.data.published.toISOString()}>{dateFormatter.format(post.data.published)}</time>
            <div>
              <h2><a href={post.data.legacyPath}>{post.data.title}</a></h2>
              <p>{post.data.description}</p>
            </div>
          </article>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .page-intro {
    padding-block: clamp(4rem, 10vw, 7rem);
  }

  .post-list {
    border-top: 1px solid var(--line);
  }

  .post-list li {
    border-bottom: 1px solid var(--line);
  }

  article {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 10rem minmax(0, 1fr);
    padding-block: 1.8rem;
  }

  time,
  article p {
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.76rem;
  }

  article h2 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    margin: 0;
  }

  article h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  article h2 a:hover {
    color: var(--accent-dark);
  }

  article p {
    margin: 0.5rem 0 0;
    max-width: 46rem;
  }

  @media (max-width: 620px) {
    article {
      grid-template-columns: 1fr;
    }
  }
</style>
