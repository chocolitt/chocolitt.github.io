---
import { getCollection, type CollectionEntry } from "astro:content";
import TaxonomyIndex from "../../../components/TaxonomyIndex.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft || import.meta.env.DEV);
  const terms = new Map<string, string>();
  for (const post of posts) {
    for (const category of post.data.categories) terms.set(category.path, category.name);
  }
  return [...terms].map(([path, label]) => ({
    params: { term: path.replace(/^\/blog\/category\//, "") },
    props: {
      label,
      path,
      posts: posts.filter((post) => post.data.categories.some((category) => category.path === path)),
    },
  }));
}

interface Props {
  label: string;
  path: string;
  posts: CollectionEntry<"blog">[];
}

const { label, path, posts } = Astro.props;
---

<TaxonomyIndex label={label} kind="Category" path={path} posts={posts} />
