---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { canonicalPath } from "../utils/url";
import BlogFrame from "./BlogFrame.astro";

interface Props {
  label: string;
  kind: "Category" | "Tag";
  path: string;
  posts: CollectionEntry<"blog">[];
}

const { label, kind, path, posts } = Astro.props;
const sortedPosts = [...posts].sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const dateFormatter = new Intl.DateTimeFormat("en-US", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout
  title={`${kind}: ${label}`}
  description={`${kind} archive for ${label} on Daniel Litt's blog.`}
  canonicalPath={path}
  math={sortedPosts.some((post) => post.data.math)}
>
  <BlogFrame>
    <section class="taxonomy-index">
      <header class="taxonomy-header">
        <h1>{kind}: {label}</h1>
      </header>
      <ol class="plain-list">
        {sortedPosts.map((post) => (
          <li>
            <h2><a href={canonicalPath(post.data.legacyPath)}>{post.data.title}</a></h2>
            <time datetime={post.data.published.toISOString()}>{dateFormatter.format(post.data.published)}</time>
            <p>{post.data.description}</p>
          </li>
        ))}
      </ol>
    </section>
  </BlogFrame>
</BaseLayout>

<style>
  .taxonomy-header {
    margin-bottom: 42px;
  }

  .taxonomy-header h1,
  li h2 {
    font-size: 2rem;
    line-height: 1.5;
    margin: 0 0 6px;
  }

  li + li {
    border-top: 1px solid var(--line);
    margin-top: 2rem;
    padding-top: 2rem;
  }

  h2 a {
    color: var(--heading);
  }

  time {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 2;
  }
</style>
