---
interface Props {
  href: string;
  label: string;
  meta?: string;
}

const { href, label, meta } = Astro.props;
---

<a class="download" href={href}>
  <span aria-hidden="true">↓</span>
  <span><strong>{label}</strong>{meta && <small>{meta}</small>}</span>
</a>

<style>
  .download {
    align-items: center;
    border: 1px solid var(--line);
    color: var(--ink);
    display: inline-flex;
    font-family: var(--sans);
    gap: 0.8rem;
    padding: 0.75rem 0.9rem;
    text-decoration: none;
  }

  .download:hover {
    border-color: var(--accent);
  }

  .download > span:first-child {
    color: var(--accent);
    font-size: 1.4rem;
  }

  .download strong,
  .download small {
    display: block;
  }

  .download small {
    color: var(--muted);
    font-size: 0.68rem;
    margin-top: 0.08rem;
  }
</style>
