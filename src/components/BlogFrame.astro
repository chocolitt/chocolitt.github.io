---
import { getCollection } from "astro:content";
import BlogSidebar from "./BlogSidebar.astro";

interface Props {
  isIndex?: boolean;
}

const { isIndex = false } = Astro.props;
const posts = await getCollection("blog", ({ data }) => !data.draft);
---

<section class="blog-shell shell page-content">
  {isIndex ? (
    <h1 class="blog-collection-title"><a href="/blog/">Betalog</a></h1>
  ) : (
    <p class="blog-collection-title"><a href="/blog/">Betalog</a></p>
  )}
  <div class="blog-layout">
    <div class="blog-main">
      <slot />
    </div>
    <BlogSidebar posts={posts} />
  </div>
</section>

<style>
  .blog-shell {
    padding-top: 67px;
  }

  .blog-collection-title {
    font-family: var(--display-font);
    font-size: 2rem;
    font-weight: 300;
    letter-spacing: 0.06em;
    line-height: 1.5;
    margin: 0 0 50px;
    text-align: center;
    text-transform: uppercase;
  }

  .blog-collection-title a {
    color: var(--heading);
  }

  .blog-layout {
    align-items: start;
    display: grid;
    gap: 50px;
    grid-template-columns: minmax(0, 4.4fr) minmax(180px, 1fr);
  }

  .blog-main {
    min-width: 0;
  }

  @media (max-width: 900px) {
    .blog-layout {
      display: block;
    }
  }

  @media (max-width: 750px) {
    .blog-shell {
      padding-top: 58px;
    }

    .blog-collection-title {
      margin-bottom: 72px;
    }
  }
</style>
