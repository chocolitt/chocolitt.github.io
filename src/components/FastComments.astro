---
interface Props {
  urlId: string;
  canonicalUrl?: string;
}

const { urlId } = Astro.props;
if (!urlId.startsWith("/") || urlId.includes("?") || urlId.includes("#")) {
  throw new Error(`FastComments urlId must be a clean site-relative path: ${urlId}`);
}

const tenantId = import.meta.env.PUBLIC_FASTCOMMENTS_TENANT_ID;
const canonicalUrl = Astro.props.canonicalUrl ?? new URL(urlId, Astro.site).href;
---

<section class="comments" aria-labelledby="comments-heading">
  <h2 id="comments-heading">Comments</h2>
  {tenantId ? (
    <>
      <div id="fastcomments-widget"></div>
      <noscript>JavaScript is required to read and leave comments.</noscript>
      <script is:inline define:vars={{ tenantId, urlId, canonicalUrl }}>
        window.fcConfigs = [{ tenantId, urlId, url: canonicalUrl }];
      </script>
      <script is:inline async src="https://cdn.fastcomments.com/js/embed-v2-async.min.js"></script>
    </>
  ) : null}
</section>

<style>
  .comments {
    border-top: 1px solid var(--line);
    margin-top: 4rem;
    padding-top: 1.6rem;
  }

  .comments h2 {
    margin-top: 0;
  }
</style>
